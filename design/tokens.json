{
  "meta": {
    "product": "壁纸时移 (Wallpaper Shift)",
    "source": "Android MVP 0.1.0, accepted on a vivo V2454A on 2026-10-20",
    "units": "dp/sp follow Android density-independent units; use pt on iOS and px at 1x on the web",
    "doc": "design/README.md explains every token and where it is used"
  },
  "color": {
    "brand": {
      "night": "#232B66",
      "dusk": "#7B4F92",
      "sunrise": "#F4A261",
      "glyph": "#FFFFFF",
      "note": "Icon background gradient, top to bottom: night → dusk (50%) → sunrise. The glyph is pure white; its second horizon line is white at 70% opacity."
    },
    "dynamicColor": "Where the platform derives a colour scheme from the wallpaper (Android 12+ Material You), use it. The app then changes colour with the time of day, together with the pictures it sets. The palettes below are the fallback.",
    "fallback": {
      "light": {
        "primary": "#3F4A8A",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#DDE1FF",
        "onPrimaryContainer": "#00105C",
        "secondary": "#9A4F2B",
        "secondaryContainer": "#FFDBCC",
        "onSecondaryContainer": "#370E00"
      },
      "dark": {
        "primary": "#B9C3FF",
        "onPrimary": "#0E1D6B",
        "primaryContainer": "#263271",
        "onPrimaryContainer": "#DDE1FF",
        "secondary": "#FFB693",
        "secondaryContainer": "#7B3816",
        "onSecondaryContainer": "#FFDBCC"
      },
      "note": "Roles not listed (surface, error, outline…) take the Material 3 baseline values for the theme."
    },
    "usage": {
      "nowCard": "secondaryContainer / onSecondaryContainer",
      "reliabilityCard": "errorContainer / onErrorContainer",
      "blurCard": "surfaceContainerHigh",
      "currentSlotOutline": "primary",
      "startTime": "primary",
      "destructiveButton": "error (filled) / onError",
      "secondaryText": "onSurfaceVariant",
      "imagePlaceholder": "surfaceVariant",
      "phonePreviewBorder": "outlineVariant",
      "overlayOnPicture": { "lockClock": "#FFFFFF", "homeIconDots": "#FFFFFFBF" }
    }
  },
  "typography": {
    "family": "System UI font (Android: Roboto + Noto Sans CJK; iOS: SF Pro + PingFang SC)",
    "scale": {
      "headlineSmall": { "size": 24, "lineHeight": 32, "weight": 400 },
      "titleLarge": { "size": 22, "lineHeight": 28, "weight": 400 },
      "titleMedium": { "size": 16, "lineHeight": 24, "weight": 500 },
      "titleSmall": { "size": 14, "lineHeight": 20, "weight": 500 },
      "bodyLarge": { "size": 16, "lineHeight": 24, "weight": 400 },
      "bodyMedium": { "size": 14, "lineHeight": 20, "weight": 400 },
      "bodySmall": { "size": 12, "lineHeight": 16, "weight": 400 },
      "labelMedium": { "size": 12, "lineHeight": 16, "weight": 500 },
      "labelSmall": { "size": 11, "lineHeight": 16, "weight": 500 }
    },
    "roles": {
      "screenTitle": "titleLarge (top app bar)",
      "sectionTitle": "titleMedium",
      "cardTitle": "titleMedium",
      "rowTitle": "titleSmall",
      "pictureName": "titleMedium",
      "infoLine": "bodyMedium",
      "secondary": "bodySmall",
      "settingName": "bodyLarge",
      "startTimeInList": "headlineSmall, weight 500",
      "timelineTime": "labelSmall (bold when current)",
      "previewCaption": "labelMedium",
      "lockPreviewClock": { "size": 26, "weight": 300 }
    },
    "numbers": "Times are always 24-hour HH:mm with tabular figures."
  },
  "shape": {
    "phonePreview": 14,
    "timelineThumb": 8,
    "listThumb": 8,
    "startTimeTapTarget": 6,
    "cards": "Material 3 medium (12)",
    "dialogs": "Material 3 extra-large (28)"
  },
  "layout": {
    "screenPadding": 16,
    "listItemSpacing": 12,
    "cardPadding": 16,
    "bottomInsetForFab": 96,
    "phonePreviewGap": 16,
    "blurCardPreviewSideInset": 24,
    "reliabilityRowIndent": 28
  },
  "component": {
    "phonePreview": {
      "aspect": "9:19.5",
      "border": 2,
      "lockClockTop": 22,
      "homeIconDot": 14,
      "homeIconGrid": "2 rows × 4",
      "homeIconGap": 8,
      "homeIconsBottom": 14,
      "captionTop": 6
    },
    "dayTimeline": {
      "thumbAspect": "9:19.5",
      "imageFit": "contain (whole picture, never cropped)",
      "gap": 6,
      "minFitWidth": 40,
      "scrollThumbWidth": 60,
      "timeLabelTop": 4,
      "currentOutline": 2.5,
      "scrollOpensAt": "the current picture, with one picture of context before it"
    },
    "listItem": { "thumbWidth": 44, "thumbHeight": 88, "padding": 10, "textInset": 14, "selectedBorder": 2 },
    "warningIcon": 20,
    "emptyStateIcon": 48
  },
  "behavior": {
    "minutesPerDay": 1440,
    "timeFormat": "HH:mm",
    "suggestedStart": { "emptySetFrom": "06:00", "spread": "evenly over 24 h in pick order", "nonEmpty": "midpoint of the largest gap", "roundTo": 5 },
    "maxPicturesPerPick": 24,
    "blur": { "min": 0, "max": 25, "default": 10, "workWidthPx": 240, "passes": 3, "kind": "box blur, then scaled back to the picture's size" },
    "import": { "coverScreen": true, "maxPixels": 16000000, "lockJpegQuality": 95, "homeJpegQuality": 90, "thumbWidthPx": 360, "thumbJpegQuality": 85 },
    "applyOrder": ["lock screen (original)", "home screen (blurred)"],
    "missedSwitchGraceMinutes": 15,
    "inexactAlarmWindowMinutes": 10,
    "demoSet": {
      "name": "一日光影（示例）",
      "assets": "shared/demo-assets/demo/ (bundled in every build)",
      "firstLaunch": "Created once if the user has no sets, left disabled; its pictures are copied once to the photo library album 壁纸时移 (Android: Pictures/壁纸时移/, Android 10+ only)",
      "galleryAlbum": "壁纸时移",
      "starts": { "01-dawn": "05:00", "02-morning": "07:30", "03-noon": "11:00", "04-afternoon": "14:00", "05-sunset": "17:30", "06-night": "19:30" }
    }
  }
