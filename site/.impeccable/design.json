  "narrative": {
    "northStar": "一间书房，六种光线",
    "overview": "The page gives a quiet, tactile frame to changing light: charcoal fields hold the artwork and solar explanation; plaster-light paper holds reading and practical steps. Warm gold marks action and the active afternoon, with plum supporting the adjustable blur control and cool blue distinguishing sunset. The visual language is spacious, ruled, and geometric.\n\nThis system documents the finished static product page only. Leo’s book-reaching study artwork is demonstration content, not the product identity. The existing product icon, Android download, user-owned wallpaper sets, and honest device limitations anchor the page. Android application styling remains governed separately by ../design/README.md.",
    "keyCharacteristics": [
      "Two-tone charcoal and paper reading fields.",
      "Whole-heading oblique geometry with crisp Chinese sans lettering.",
      "Chamfered gold download actions and straight divider rules.",
      "Real six-state artwork, native controls, and primitive phone silhouettes."
    ],
    "rules": [
      {
        "name": "The Gold Action Rule",
        "body": "Use gold for download actions, the time rail, and solar emphasis; the active time label may adopt its frame’s light color. Keep download labels dark.",
        "section": "colors"
      },
      {
        "name": "The One Heading Voice Rule",
        "body": "Use Noto Sans SC 600 for h1 and h2, with whole-element skewX(-9deg); the hero adds scaleX(1.08). Keep body copy upright.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Reserve ambient shadows for the phone demonstrations and subtle hero text separation; reading sections use texture, tone, and rules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the charcoal/paper alternation and generous section spacing.",
      "Do keep real buttons, native range inputs, details/summary, visible keyboard focus, and the skip link.",
      "Do show all six image slices on desktop and one active image at widths of 900px or less.",
      "Do keep the wallpaper and blur demonstrations synchronized while preserving clear lock-screen detail.",
      "Do retain reduced-motion CSS, disable default autoplay for that preference, and expose pause controls for the normal automatic cycle."
    ],
    "donts": [
      "Don't turn Leo’s demonstration artwork into the product’s identity.",
